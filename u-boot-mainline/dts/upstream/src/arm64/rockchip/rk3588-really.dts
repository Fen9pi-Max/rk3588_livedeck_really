/*
 * Minimal U-Boot device tree for the Really/TVI2340R RK3588 board.
 *
 * U-Boot only needs stable console, eMMC and SD access here.  Linux device
 * setup (panel, audio, HDMI input, cameras) remains in the kernel DTS.
 */

/dts-v1/;
#include "rk3588.dtsi"

/ {
	model = "Really RK3588 Live Streaming Box";
	compatible = "rockchip,rk3588-tvi2340r", "rockchip,rk3588";

	/*
	 * Rails that must be up before U-Boot hands over to Linux.
	 *
	 * vcc28_dvp (AVDD28) and vcc1v8_sys (VDDIO) feed the GT9110 touch
	 * controller at I2C4 0x14 and the HYM8563 RTC at 0x51.  Linux probes
	 * those before the rails have settled, so both NAK and the kernel needs
	 * a userspace rebind to recover them.  vcc5v0_sys is their upstream
	 * supply; lvds_pwr_en powers the LT9211 LVDS path.
	 *
	 * Declaring the nodes here is not enough on its own: nothing in U-Boot
	 * probes a regulator-fixed device, so the enable GPIOs would stay low
	 * for the whole boot.  board_init() drives them explicitly through
	 * regulator_autoset_by_name().
	 *
	 * GPIO offsets are raw bank-pin numbers because this file does not
	 * include the pinctrl dt-bindings header: 16 = GPIO0_C0,
	 * 14 = GPIO3_B6.  This matches the vcc_sd node below.
	 */
	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc28_dvp: regulator-vcc28-dvp {
		compatible = "regulator-fixed";
		regulator-name = "vcc28_dvp";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc1v8_sys: regulator-vcc1v8-sys {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 16 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&really_vcc1v8_sys_en>;
		regulator-name = "vcc1v8_sys";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	lvds_pwr_en: regulator-lvds-pwr-en {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 14 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&really_lvds_pwren>;
		regulator-name = "lvds_pwr_en";
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_sd: regulator-vcc-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 19 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&really_sdmmc_pwr>;
		enable-active-high;
		startup-delay-us = <100000>;
		vin-supply = <&vcc_3v3_s3>;
		regulator-always-on;
	};

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};
};

&pinctrl {
	really_sdmmc_pwr: sdmmc-pwr {
		rockchip,pins = <4 19 0 &pcfg_pull_none>;
	};

	really_vcc1v8_sys_en: vcc1v8-sys-en {
		rockchip,pins = <0 16 0 &pcfg_pull_up>;
	};

	really_lvds_pwren: lvds-pwren {
		rockchip,pins = <3 14 0 &pcfg_pull_none>;
	};
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	sd-uhs-sdr104;
	supports-sd;
	status = "okay";
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd_s0>;
};

&spi2 {
	status = "okay";
	assigned-clocks = <&cru CLK_SPI2>;
	assigned-clock-rates = <200000000>;
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi2m2_pins>, <&spi2m2_cs0>;

	pmic@0 {
		compatible = "rockchip,rk806";
		reg = <0x0>;
		spi-max-frequency = <1000000>;
		interrupt-parent = <&gpio0>;
		interrupts = <7 8>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins>, <&rk806_dvs1_null>,
			    <&rk806_dvs2_null>, <&rk806_dvs3_null>;
		system-power-controller;
		gpio-controller;
		#gpio-cells = <2>;

		rk806_dvs1_null: dvs1-null-pins {
			pins = "gpio_pwrctrl1";
			function = "pin_fun0";
		};

		rk806_dvs2_null: dvs2-null-pins {
			pins = "gpio_pwrctrl2";
			function = "pin_fun0";
		};

		rk806_dvs3_null: dvs3-null-pins {
			pins = "gpio_pwrctrl3";
			function = "pin_fun0";
		};

		regulators {
			vcc_3v3_s3: dcdc-reg8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vcc_3v3_s3";
			};

			vccio_sd_s0: pldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-init-microvolt = <3300000>;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vccio_sd_s0";
			};
		};
	};
};

&uart2 {
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	status = "okay";
};
